<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_in" />

        <TextView
            android:id="@+id/txtIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_folder" />

        <Button
            android:id="@+id/btnOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_out" />

        <TextView
            android:id="@+id/txtOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_folder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_translator" />

        <RadioGroup
            android:id="@+id/rgProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbMlkit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rb_mlkit" />

            <RadioButton
                android:id="@+id/rbDeepl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_deepl" />

            <RadioButton
                android:id="@+id/rbGoogle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_google" />
        </RadioGroup>

        <EditText
            android:id="@+id/etKeyDeepl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_deepl"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etKeyGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_google"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/cbFallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cb_fallback" />

        <CheckBox
            android:id="@+id/cbPlugins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/cb_plugins" />

        <EditText
            android:id="@+id/etWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_width"
            android:importantForAutofill="no"
            android:inputType="number"
            android:text="50" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/btn_cancel" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_ready" />

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
